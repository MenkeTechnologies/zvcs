    "--no-all",
    "--ignore-removal",
    "--no-ignore-removal",
    "--refresh",
    "--no-refresh",
    "--ignore-errors",
    "--no-ignore-errors",
    "--ignore-missing",
    "--no-ignore-missing",
    "--sparse",
    "--no-sparse",
