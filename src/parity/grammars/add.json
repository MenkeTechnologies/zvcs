  "flags": [
    "-n",
    "--dry-run",
    "--no-dry-run",
    "-v",
    "--verbose",
    "--no-verbose",
    "-i",
    "--interactive",
    "--no-interactive",
    "-p",
    "--patch",
    "--no-patch",
    "--auto-advance",
    "--no-auto-advance",
    "-U1",
    "--unified=0",
    "--unified=3",
