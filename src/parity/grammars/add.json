  "shapes": [
    "linear",
    "branched",
    "merged",
    "dirty",
    "conflicted",
    "detached",
    "awkward-paths",
    "submodule",
    "attributes",
    "sparse",
    "renamed",
    "whitespace",
    "stashed",
    "patches",
    "packed",
    "decomposed-paths",
    "mergeable-dirty",
