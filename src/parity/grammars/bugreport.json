{
  "command": "bugreport",
  "mutating": true,
  "flags": [
    "--diagnose",
    "--diagnose=stats",
    "--diagnose=all",
    "--diagnose=bogus",
    "--no-diagnose",
    "-o.git/parity-bugreport",
    "--output-directory=.git/parity-bugreport",
    "--output-directory=does-not-exist",
    "--no-output-directory",
    "-sparity",
    "--suffix=parity",
    "--suffix=%Y",
    "--no-suffix"
  ],
  "positionals": [],
  "shapes": [
    "linear",
    "branched",
    "merged",
    "dirty",
    "detached",
    "submodule",
    "packed",
    "worktree",
    "behind-remote",
    "sparse"
  ]
}
