{
  "command": "checkout-index",
  "mutating": true,
  "flags": [
    "-a",
    "--all",
    "--no-all",
    "--ignore-skip-worktree-bits",
    "--no-ignore-skip-worktree-bits",
    "-f",
    "--force",
    "--no-force",
    "-q",
    "--quiet",
    "--no-quiet",
    "-n",
    "--no-create",
    "--create",
    "-u",
    "--index",
    "--no-index",
    "-z",
    "--stdin",
    "--no-stdin",
    "--temp",
    "--no-temp",
    "--prefix=.git/parity-co/",
    "--prefix=",
    "--no-prefix",
    "--stage=1",
    "--stage=2",
    "--stage=3",
    "--stage=all",
    "--stage=bogus"
  ],
  "positionals": [
    "README.md",
    "src/lib.rs",
    "src",
    ".",
    "*.rs",
    ":^src",
    "does-not-exist",
    "",
    "inside",
    "inside/keep.txt",
    "outside",
    "outside/drop.txt",
    "outside/stray.txt",
    "root.txt",
    "é.txt",
    "é-new.txt",
    "with space.txt",
    "üñïçødé.txt",
    "nested/deep/path.txt",
    "conflict.txt",
    "link-to-file",
    "link-to-dir",
    "link-to-link",
    "link-broken",
    "link-escape",
    "link-wt",
    "dir/link-up",
    "empty.txt",
    "dir/empty-nested.txt"
  ],
  "shapes": [
    "linear",
    "branched",
    "merged",
    "dirty",
    "conflicted",
    "detached",
    "awkward-paths",
    "submodule",
    "sparse",
    "attributes",
    "renamed",
    "decomposed-paths",
    "mergeable-dirty",
    "symlinks"
  ]
}
