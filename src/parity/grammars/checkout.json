{
  "command": "checkout",
  "mutating": true,
  "flags": [
    "-bparity-new",
    "-Bparity-force",
    "-l",
    "--guess",
    "--no-guess",
    "--overlay",
    "--no-overlay",
    "--auto-advance",
    "--no-auto-advance",
    "-q",
    "--quiet",
    "--no-quiet",
    "--recurse-submodules",
    "--no-recurse-submodules",
    "--recurse-submodules=yes",
    "--recurse-submodules=no",
    "--progress",
    "--no-progress",
    "-m",
    "--merge",
    "--no-merge",
    "--conflict=merge",
    "--conflict=diff3",
    "--conflict=zdiff3",
    "--conflict=bogus",
    "--no-conflict",
    "-d",
    "--detach",
    "--no-detach",
    "-t",
    "--track",
    "--track=direct",
    "--track=inherit",
    "--track=bogus",
    "--no-track",
    "-f",
    "--force",
    "--no-force",
    "--orphan=parity-orphan",
    "--no-orphan",
    "--overwrite-ignore",
    "--no-overwrite-ignore",
    "--ignore-other-worktrees",
    "--no-ignore-other-worktrees",
    "-2",
    "--ours",
    "-3",
    "--theirs",
    "-p",
    "--patch",
    "--no-patch",
    "-U1",
    "--unified=3",
    "--inter-hunk-context=2",
    "--ignore-skip-worktree-bits",
    "--no-ignore-skip-worktree-bits",
    "--pathspec-from-file=.git/parity-pathspec",
    "--no-pathspec-from-file",
    "--pathspec-file-nul"
  ],
  "positionals": [
    "HEAD",
    "HEAD~1",
    "HEAD~2",
    "HEAD^",
    "HEAD^{tree}",
    "main",
    "feature",
    "v0.1.0",
    "v0.2.0",
    "@{-1}",
    "does-not-exist",
    "README.md",
    "src/lib.rs",
    "src",
    ".",
    "*.rs",
    ":^src",
    "",
    "ff-cold",
    "ff-hot",
    "ff-squat",
    "div-cold",
    "div-hot",
    "div-squat",
    "div-other",
    "oct-a",
    "oct-b",
    "oct-c",
    "oct-side",
    "HEAD^2",
    "HEAD^3",
    "linked",
    "origin/main",
    "conflict.txt",
    "--",
    "sym-pending",
    "link-wt",
    "link-to-file",
    "link-to-dir",
    "dir/link-up",
    "empty.txt",
    "stray-link"
  ],
  "shapes": [
    "linear",
    "branched",
    "merged",
    "dirty",
    "conflicted",
    "detached",
    "awkward-paths",
    "submodule",
    "sparse",
    "renamed",
    "whitespace",
    "stashed",
    "worktree",
    "behind-remote",
    "octopus",
    "mergeable-dirty",
    "mergeable-staged",
    "decomposed-paths",
    "symlinks"
  ]
}
