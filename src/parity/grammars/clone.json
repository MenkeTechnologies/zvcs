  "positionals": [
    "./.remote.git",
    "./.git",
    "sub",
    "does-not-exist",
    "parity-clone",
    ".git/parity-clone",
    "--bogus-option"
  ],
  "shapes": [
    "linear",
    "branched",
    "merged",
    "dirty",
    "conflicted",
    "detached",
    "awkward-paths",
    "submodule",
    "packed",
    "behind-remote",
    "sparse",
    "worktree",
    "octopus",
    "renamed",
    "attributes",
    "shallow",
    "promisor"
  ]
}
