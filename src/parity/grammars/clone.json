{
  "command": "clone",
  "mutating": true,
  "flags": [
    "-v",
    "--verbose",
    "--no-verbose",
    "-q",
    "--quiet",
    "--no-quiet",
    "--progress",
    "--no-progress",
    "--reject-shallow",
    "--no-reject-shallow",
    "-n",
    "--no-checkout",
    "--checkout",
    "--bare",
    "--no-bare",
    "--mirror",
    "--no-mirror",
    "-l",
    "--local",
    "--no-local",
    "--no-hardlinks",
    "--hardlinks",
    "-s",
    "--shared",
    "--no-shared",
    "--recurse-submodules",
    "--no-recurse-submodules",
    "--recursive",
    "--no-recursive",
    "-j1",
    "--jobs=2",
    "--template=does-not-exist",
    "--no-template",
    "--reference=does-not-exist",
    "--reference-if-able=does-not-exist",
    "--no-reference",
    "--dissociate",
    "--no-dissociate",
    "-oupstream",
    "--origin=upstream",
    "--no-origin",
    "-bmain",
    "--branch=main",
    "--branch=does-not-exist",
    "--no-branch",
    "--revision=HEAD",
    "--revision=does-not-exist",
    "--no-revision",
    "--upload-pack=true",
    "--no-upload-pack",
    "--depth=1",
    "--depth=0",
    "--no-depth",
    "--shallow-since=1979-01-01",
    "--shallow-exclude=main",
    "--no-shallow-exclude",
    "--single-branch",
    "--no-single-branch",
    "--tags",
    "--no-tags",
    "--shallow-submodules",
    "--no-shallow-submodules",
    "--separate-git-dir=.git/parity-clone-gitdir",
    "--no-separate-git-dir",
    "--ref-format=files",
    "--ref-format=reftable",
    "--ref-format=bogus",
    "-ccore.abbrev=10",
    "--config=core.abbrev=10",
    "--no-config",
    "--server-option=parity",
    "--no-server-option",
    "-4",
    "--ipv4",
    "-6",
    "--ipv6",
    "--filter=blob:none",
    "--filter=bogus",
    "--no-filter",
    "--also-filter-submodules",
    "--no-also-filter-submodules",
