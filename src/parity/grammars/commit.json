  "shapes": [
    "linear",
    "branched",
    "merged",
    "dirty",
    "conflicted",
    "detached",
    "awkward-paths",
    "submodule",
    "attributes",
    "renamed",
    "whitespace",
    "sparse",
    "stashed",
    "packed",
    "decomposed-paths",
    "mergeable-dirty",
    "mergeable-staged",
    "octopus",
    "hooks-fail",
