  "positionals": [
    "README.md",
    "src/lib.rs",
    "src",
    ".",
    "*.rs",
    ":^src",
    "does-not-exist",
    "",
    "staged.txt",
    "untracked.txt",
    "inside",
    "inside/keep.txt",
    "outside",
    "outside/drop.txt",
    "outside/stray.txt",
    "root.txt",
    "é.txt",
    "é-new.txt",
    "conflict.txt",
    "hf-main.txt",
    "side-base.txt",
    "hf-ahead.txt",
    "sub/nested.txt",
    "top.txt",
    "sub"
