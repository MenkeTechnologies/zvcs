{
  "command": "commit",
  "mutating": true,
  "flags": [
    "-q",
    "--quiet",
    "--no-quiet",
    "-v",
    "--verbose",
    "--no-verbose",
    "-FREADME.md",
    "--file=README.md",
    "--file=does-not-exist",
    "--no-file",
    "--author=Someone",
