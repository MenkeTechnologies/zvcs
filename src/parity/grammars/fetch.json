    "--no-multiple",
    "-t",
    "--tags",
    "--no-tags",
    "-n",
    "-j1",
    "--jobs=2",
    "--prefetch",
    "--no-prefetch",
    "-p",
    "--prune",
    "--no-prune",
    "-P",
    "--prune-tags",
    "--no-prune-tags",
