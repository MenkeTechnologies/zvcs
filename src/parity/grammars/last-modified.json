{
  "command": "last-modified",
  "mutating": false,
  "flags": [
    "-r",
    "--recursive",
    "--no-recursive",
    "-t",
    "--show-trees",
    "--no-show-trees",
    "--max-depth=0",
    "--max-depth=1",
    "--max-depth=2",
    "--max-depth=-1",
    "-z"
  ],
  "positionals": [
    "HEAD",
    "HEAD~1",
    "HEAD~2",
    "HEAD^",
    "HEAD^{tree}",
    "main",
    "feature",
    "v0.1.0",
    "v0.2.0",
    "@{-1}",
    "does-not-exist",
    "README.md",
    "src/lib.rs",
    "src",
    ".",
    "*.rs",
    ":^src",
    "",
    "orig/alpha.txt",
    "orig/beta.txt",
    "moved/alpha.txt",
    "copies/gamma.txt",
    "é.txt",
    "é-new.txt",
    "main..HEAD",
    "--"
  ],
  "shapes": [
    "linear",
    "branched",
    "merged",
    "dirty",
    "conflicted",
    "detached",
    "awkward-paths",
    "submodule",
    "renamed",
    "whitespace",
    "attributes",
    "packed",
    "sparse",
    "octopus",
    "decomposed-paths"
  ]
}
