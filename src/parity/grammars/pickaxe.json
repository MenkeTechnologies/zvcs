{
  "command": "pickaxe",
  "mutating": false,
  "flags": [
    "--incremental",
    "--no-incremental",
    "-b",
    "--root",
    "--no-root",
    "--show-stats",
    "--no-show-stats",
    "--progress",
    "--no-progress",
    "--score-debug",
    "--no-score-debug",
    "-f",
    "--show-name",
    "--no-show-name",
    "-n",
    "--show-number",
    "--no-show-number",
    "-p",
    "--porcelain",
    "--no-porcelain",
    "--line-porcelain",
    "--no-line-porcelain",
    "-c",
    "-t",
    "-l",
    "-s",
    "-e",
    "--show-email",
    "--no-show-email",
    "-w",
    "--diff-algorithm=myers",
    "--diff-algorithm=minimal",
    "--diff-algorithm=patience",
    "--diff-algorithm=histogram",
    "--diff-algorithm=bogus",
    "--ignore-rev=HEAD",
    "--ignore-rev=does-not-exist",
    "--no-ignore-rev",
    "--ignore-revs-file=does-not-exist",
    "--no-ignore-revs-file",
    "--color-lines",
    "--no-color-lines",
    "--color-by-age",
    "--no-color-by-age",
    "-SREADME.md",
    "--contents=README.md",
    "--no-contents",
    "-C",
    "-C50",
    "-M",
    "-M50",
    "-L1,2",
    "-L1,",
    "-L,2",
    "-L:main",
    "--abbrev",
    "--abbrev=4",
    "--no-abbrev"
  ],
  "positionals": [
    "HEAD",
    "HEAD~1",
    "HEAD~2",
    "HEAD^",
    "HEAD^{tree}",
    "main",
    "feature",
    "v0.1.0",
    "v0.2.0",
    "@{-1}",
    "does-not-exist",
    "README.md",
    "src/lib.rs",
    "src",
    ".",
    "*.rs",
    ":^src",
    "",
    "orig/alpha.txt",
    "orig/beta.txt",
    "moved/alpha.txt",
    "copies/gamma.txt",
    "ws/indent.c",
    "ws/eol.txt",
    "é.txt",
    "é-new.txt",
    "--"
  ],
  "shapes": [
    "linear",
    "branched",
    "merged",
    "dirty",
    "conflicted",
    "detached",
    "awkward-paths",
    "submodule",
    "renamed",
    "whitespace",
    "attributes",
    "packed",
    "octopus",
    "decomposed-paths"
  ]
}
