{
  "command": "pull",
  "mutating": true,
  "flags": [
    "-v",
    "--verbose",
    "--no-verbose",
    "-q",
    "--quiet",
    "--no-quiet",
    "--progress",
    "--no-progress",
    "--recurse-submodules",
    "--recurse-submodules=yes",
    "--recurse-submodules=on-demand",
    "--recurse-submodules=no",
    "--no-recurse-submodules",
    "-r",
    "--rebase",
    "--rebase=false",
    "--rebase=true",
    "--rebase=merges",
    "--rebase=interactive",
    "--rebase=bogus",
    "--no-rebase",
    "-n",
    "--stat",
    "--no-stat",
    "--compact-summary",
    "--no-compact-summary",
    "--log",
    "--log=1",
    "--no-log",
    "--signoff",
    "--no-signoff",
    "--squash",
    "--no-squash",
    "--commit",
    "--no-commit",
    "--edit",
    "--no-edit",
    "--cleanup=verbatim",
    "--cleanup=strip",
    "--no-cleanup",
    "--ff",
    "--no-ff",
    "--ff-only",
    "--verify",
    "--no-verify",
    "--verify-signatures",
    "--no-verify-signatures",
    "--autostash",
    "--no-autostash",
    "-sort",
    "-sresolve",
    "--strategy=ort",
    "--strategy=bogus",
    "--no-strategy",
    "-Xtheirs",
    "-Xours",
    "--strategy-option=theirs",
    "--no-strategy-option",
    "--no-gpg-sign",
    "--allow-unrelated-histories",
    "--no-allow-unrelated-histories",
    "--all",
    "--no-all",
    "-a",
