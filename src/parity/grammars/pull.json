    "dirty",
    "conflicted",
    "detached",
    "awkward-paths",
    "submodule",
    "behind-remote",
    "mergeable-dirty",
    "mergeable-staged",
    "octopus",
    "packed",
    "worktree",
    "sparse",
    "stashed",
    "unrelated"
