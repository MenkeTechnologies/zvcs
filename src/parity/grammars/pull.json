    "--no-append",
    "--upload-pack=true",
    "--no-upload-pack",
    "-f",
    "--force",
    "--no-force",
    "-t",
    "--tags",
    "--no-tags",
    "-p",
    "--prune",
    "--no-prune",
    "-j1",
    "--jobs=2",
    "--no-jobs",
    "--dry-run",
    "--no-dry-run",
    "-k",
    "--keep",
    "--no-keep",
    "--depth=1",
    "--no-depth",
    "--shallow-since=1979-01-01",
    "--shallow-exclude=main",
    "--deepen=1",
    "--no-deepen",
