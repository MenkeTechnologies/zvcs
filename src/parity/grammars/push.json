{
  "command": "push",
  "mutating": true,
  "flags": [
    "-v",
    "--verbose",
    "--no-verbose",
    "-q",
    "--quiet",
    "--no-quiet",
    "--repo=origin",
    "--repo=./.remote.git",
    "--no-repo",
    "--all",
    "--no-all",
    "--branches",
    "--no-branches",
    "--mirror",
    "--no-mirror",
    "-d",
    "--delete",
    "--no-delete",
    "--tags",
    "--no-tags",
    "-n",
    "--dry-run",
    "--no-dry-run",
    "--porcelain",
    "--no-porcelain",
    "-f",
    "--force",
    "--no-force",
    "--force-with-lease",
    "--force-with-lease=main",
    "--force-with-lease=main:HEAD",
    "--no-force-with-lease",
    "--force-if-includes",
    "--no-force-if-includes",
    "--recurse-submodules=check",
    "--recurse-submodules=on-demand",
    "--recurse-submodules=no",
    "--recurse-submodules=bogus",
    "--no-recurse-submodules",
    "--thin",
    "--no-thin",
    "--receive-pack=true",
    "--no-receive-pack",
    "--exec=true",
    "--no-exec",
    "-u",
    "--set-upstream",
    "--no-set-upstream",
    "--progress",
    "--no-progress",
    "--prune",
    "--no-prune",
    "--no-verify",
    "--verify",
    "--follow-tags",
    "--no-follow-tags",
    "--signed=no",
    "--signed=if-asked",
    "--no-signed",
    "--atomic",
    "--no-atomic",
    "-oparity",
    "--push-option=parity",
    "--no-push-option",
    "-4",
    "--ipv4",
    "-6",
    "--ipv6"
  ],
  "positionals": [
    "origin",
    "origin/main",
    "origin/div",
    "./.remote.git",
    "refs/heads/main:refs/remotes/origin/main",
    "+refs/heads/*:refs/remotes/origin/*",
    "main",
    "div",
    "HEAD:refs/heads/parity",
    ":refs/heads/div",
    "does-not-exist",
    "",
    "veto",
    "hf-side",
    "refs/heads/veto",
    ["origin", "veto"],
    ["origin", "main"],
    ["origin", "main", "veto"],
    ["origin", "hf-side"]
  ],
  "shapes": [
    "linear",
    "branched",
    "merged",
    "dirty",
    "conflicted",
    "detached",
    "awkward-paths",
    "submodule",
    "behind-remote",
    "packed",
    "worktree",
    "octopus",
    "sparse",
    "stashed",
    "hooks-fail"
  ]
}
