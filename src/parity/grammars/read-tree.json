{
  "command": "read-tree",
  "mutating": true,
  "flags": [
    "-m",
    "--reset",
    "-u",
    "-i",
    "-n",
    "--dry-run",
    "-v",
    "--verbose",
    "-q",
    "--quiet",
    "--trivial",
    "--aggressive",
    "--empty",
    "--no-empty",
    "--sparse-checkout",
    "--no-sparse-checkout",
    "--recurse-submodules",
    "--no-recurse-submodules",
    "--prefix=sub/",
    "--index-output=.git/parity-index",
    "--exclude-per-directory=.gitignore"
  ],
  "positionals": [
    "HEAD",
    "",
    "main",
    "feature",
    "v0.1.0",
    "v0.2.0",
    "HEAD^{tree}",
    "HEAD~1",
    ["main", "feature"],
    ["HEAD", "main", "feature"],
    "does-not-exist",
    "ff-cold",
    "ff-hot",
    "ff-squat",
    "div-cold",
    "div-hot",
    "div-squat",
    "div-other",
    "keep.txt",
    "hot.txt",
    "cold.txt",
    "squat.txt",
    "oct-a",
    "oct-b",
    "oct-c",
    "oct-side",
    "HEAD^2",
    "HEAD^3",
    "HEAD^4"
  ],
  "shapes": [
    "linear",
    "branched",
    "merged",
    "dirty",
    "conflicted",
    "detached",
    "awkward-paths",
    "submodule",
    "sparse",
    "mergeable-dirty",
    "mergeable-staged",
    "renamed",
    "attributes",
    "octopus",
    "worktree",
    "decomposed-paths"
  ]
}
