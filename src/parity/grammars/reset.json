{
  "command": "reset",
  "mutating": true,
  "flags": [
    "-q",
    "--quiet",
    "--no-quiet",
    "--no-refresh",
    "--refresh",
    "--mixed",
    "--soft",
    "--hard",
    "--merge",
    "--keep",
    "--recurse-submodules",
    "--recurse-submodules=yes",
    "--recurse-submodules=no",
    "--no-recurse-submodules",
    "-p",
    "--patch",
    "--no-patch",
    "--auto-advance",
    "--no-auto-advance",
    "-U1",
    "--unified=3",
    "--inter-hunk-context=2",
    "-N",
    "--intent-to-add",
    "--no-intent-to-add",
    "--pathspec-from-file=.git/parity-pathspec",
    "--no-pathspec-from-file",
    "--pathspec-file-nul"
  ],
  "positionals": [
    "HEAD",
    "HEAD~1",
    "HEAD~2",
    "HEAD^",
    "HEAD^{tree}",
    "main",
    "feature",
    "v0.1.0",
    "v0.2.0",
    "@{-1}",
    "does-not-exist",
    "README.md",
    "src/lib.rs",
    "src",
    ".",
    "*.rs",
    ":^src",
    "",
    "inside",
    "inside/keep.txt",
    "outside",
    "outside/drop.txt",
    "outside/stray.txt",
    "root.txt",
    "é.txt",
    "é-new.txt",
    "conflict.txt",
    "--"
  ],
  "shapes": [
    "linear",
    "branched",
    "merged",
    "dirty",
    "conflicted",
    "detached",
    "awkward-paths",
    "submodule",
    "sparse",
    "renamed",
    "whitespace",
    "attributes",
    "stashed",
    "packed",
    "octopus",
    "mergeable-dirty",
    "mergeable-staged",
    "decomposed-paths"
  ]
}
