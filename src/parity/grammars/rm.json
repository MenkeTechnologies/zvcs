  "positionals": [
    "README.md",
    "src/lib.rs",
    "src",
    ".",
    "*.rs",
    ":^src",
    "does-not-exist",
    "",
    "inside",
    "inside/keep.txt",
    "outside",
    "outside/drop.txt",
    "outside/stray.txt",
    "root.txt",
    "é.txt",
    "é-new.txt",
    "with space.txt",
    "üñïçødé.txt",
    "nested/deep/path.txt",
    "conflict.txt",
    "sub",
    "--",
