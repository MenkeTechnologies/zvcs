    "sub/ita-nested.txt",
    "ita-gone.txt",
    "both.txt",
    "tracked.txt"
  ],
  "shapes": [
    "linear",
    "branched",
    "merged",
    "dirty",
    "conflicted",
    "detached",
    "awkward-paths",
    "submodule",
    "sparse",
    "renamed",
    "attributes",
    "stashed",
    "decomposed-paths",
    "intent-to-add"
