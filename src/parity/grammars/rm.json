{
  "command": "rm",
  "mutating": true,
  "flags": [
    "-n",
    "--dry-run",
    "--no-dry-run",
    "-q",
    "--quiet",
    "--no-quiet",
    "--cached",
    "--no-cached",
    "-f",
    "--force",
    "--no-force",
    "-r",
    "--ignore-unmatch",
    "--no-ignore-unmatch",
    "--sparse",
    "--no-sparse",
    "--pathspec-from-file=.git/parity-pathspec",
    "--no-pathspec-from-file",
    "--pathspec-file-nul"
