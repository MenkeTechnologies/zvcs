{
  "command": "stash",
  "mutating": true,
  "flags": [
    "-k",
    "--keep-index",
    "--no-keep-index",
    "-S",
    "--staged",
    "--no-staged",
    "-p",
    "--patch",
    "--no-patch",
    "--auto-advance",
    "--no-auto-advance",
    "-U1",
    "--unified=3",
    "--inter-hunk-context=2",
    "-q",
    "--quiet",
    "--no-quiet",
    "-u",
    "--include-untracked",
    "--no-include-untracked",
    "-a",
    "--all",
    "--no-all",
    "-mparity",
    "--message=parity",
    "--no-message",
    "--pathspec-from-file=.git/parity-pathspec",
    "--no-pathspec-from-file",
    "--pathspec-file-nul",
    "--only-untracked",
    "--index",
    "--print",
    "--to-ref=refs/parity-stash",
    "--no-to-ref",
    "--label-ours=ours",
    "--label-theirs=theirs",
    "--label-base=base"
  ],
  "positionals": [
    "list",
    "show",
    "drop",
    "pop",
    "apply",
    "branch",
    "push",
    "save",
    "clear",
    "create",
    "store",
    "export",
    "import",
    "stash@{0}",
    "stash@{1}",
    "stash@{2}",
    "stash@{9}",
    "refs/stash",
    "parity-branch",
    "README.md",
    "notes.txt",
    "counter.txt",
    "--",
    "does-not-exist",
    "",
    "ita-new.txt",
    "ita-gone.txt",
    "both.txt"
  ],
  "shapes": [
    "linear",
    "branched",
    "merged",
    "dirty",
    "conflicted",
    "detached",
    "awkward-paths",
    "submodule",
    "stashed",
    "sparse",
    "renamed",
    "whitespace",
    "attributes",
    "mergeable-dirty",
    "mergeable-staged",
    "decomposed-paths",
    "packed",
    "worktree",
    "intent-to-add"
  ]
}
