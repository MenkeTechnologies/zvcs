{
  "command": "subtree",
  "mutating": true,
  "flags": [
    "-q",
    "--quiet",
    "-d",
    "--debug",
    "-Psub",
    "--prefix=sub",
    "--prefix=src",
    "--prefix=does-not-exist",
    "--no-prefix",
    "--annotate=parity:",
    "--no-annotate",
    "-bparity-split",
    "--branch=parity-split",
    "--ignore-joins",
    "--no-ignore-joins",
    "--onto=HEAD",
    "--no-onto",
    "--rejoin",
    "--no-rejoin",
    "--squash",
    "--no-squash",
    "-mparity",
    "--message=parity"
  ],
  "positionals": [
    "add",
    "merge",
    "split",
    "pull",
    "push",
    "HEAD",
    "main",
    "feature",
    "./.remote.git",
    "sub",
    "does-not-exist",
    ""
  ],
  "shapes": [
    "linear",
    "branched",
    "merged",
    "dirty",
    "conflicted",
    "detached",
    "awkward-paths",
    "submodule",
    "behind-remote",
    "packed",
    "renamed",
    "sparse",
    "octopus"
  ]
}
