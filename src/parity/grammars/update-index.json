{
  "command": "update-index",
  "mutating": true,
  "flags": [
    "--add",
    "--no-add",
    "--remove",
    "--no-remove",
    "--force-remove",
    "--replace",
    "--refresh",
    "--really-refresh",
    "-q",
    "--unmerged",
    "--no-unmerged",
    "--ignore-missing",
    "--ignore-submodules",
    "--info-only",
    "--no-info-only",
    "--chmod=+x",
    "--chmod=-x",
    "--assume-unchanged",
    "--no-assume-unchanged",
    "--skip-worktree",
    "--no-skip-worktree",
    "--ignore-skip-worktree-entries",
    "--no-ignore-skip-worktree-entries",
    "--fsmonitor-valid",
    "--no-fsmonitor-valid",
    "--fsmonitor",
    "--no-fsmonitor",
    "--again",
    "-g",
    "--unresolve",
    "--clear-resolve-undo",
    "--verbose",
    "--no-verbose",
    "--force-write-index",
    "--show-index-version",
    "--index-version=2",
    "--index-version=3",
    "--index-version=4",
    "--index-version=1",
    "--split-index",
    "--no-split-index",
    "--untracked-cache",
    "--no-untracked-cache",
    "--test-untracked-cache",
    "--force-untracked-cache",
    "--cacheinfo=100644,0000000000000000000000000000000000000000,README.md",
    "--cacheinfo=100644,e69de29bb2d1d6434b8b29ae775ad8c2e48c5391,newfile.txt",
    "--cacheinfo=bogus,bogus,bogus",
    "--"
  ],
  "positionals": [
    "",
    "README.md",
    "src/lib.rs",
    "src",
    "./README.md",
    "src/",
    "does-not-exist",
    "src/does-not-exist.rs",
    "-not-a-flag",
    "inside",
    "inside/keep.txt",
    "inside/nested/also.txt",
    "outside",
    "outside/drop.txt",
    "outside/stray.txt",
    "root.txt",
    ".gitattributes",
    ".gitignore",
    ".mailmap",
    "src/tabs.rs",
    "docs/manual.md",
    "vendor/generated.js",
    "logs/keep.log",
    "assets/logo.bin",
    "sub/nested.txt",
    "build/output.o",
    "important.log",
    "notes.tmp",
    "é.txt",
    "é-new.txt",
    "ita-new.txt",
    "sub/ita-nested.txt",
    "ita-gone.txt",
    "both.txt",
    "tracked.txt"
  ],
  "shapes": [
    "linear",
    "branched",
    "merged",
    "dirty",
    "conflicted",
    "detached",
    "awkward-paths",
    "submodule",
    "sparse",
    "attributes",
    "renamed",
    "whitespace",
    "stashed",
    "worktree",
    "patches",
    "decomposed-paths",
    "intent-to-add"
  ]
}
